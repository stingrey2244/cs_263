#include <iostream>
#include <vector>
#include <thread>

void upper(std::string& s, int num_threads, int thread_num){
  int n = s.size();
  int range = n/num_threads;
  int start = range * thread_num;
  int end = (thread_num == num_threads - 1) ? n : start + range;
  
  for (int i = start; i < end; i++){
    if (s[i] >= 'a' && s[i] <= 'z'){
      s[i] -= 32;
    }
  }
}

int main(){
  std::string str;
  std::cin >> str;
  int cores = std::thread::hardware_concurrency();
  if (cores == 0) cores = 1;
  
  std::vector<std::thread> threads;

  for (int i = 0; i < cores; i++){
    threads.push_back(std::thread(upper, std::ref(str), cores, i));
  }

  for (int i = 0; i < threads.size(); i++){
    threads[i].join();
  }
  std::cout << str << std::endl;
  
}
