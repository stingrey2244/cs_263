#include <iostream>
#include <thread>
#include <mutex>
#include <vector>

std::mutex mtx;

void say_hello(){
  mtx.lock();
  std::cout << "Hello!" << std::endl;
  mtx.unlock();
}

int main(){
  int cores = std::thread::hardware_concurrency();
  std::cout << cores << std::endl;
  std::vector<std::thread> threads;
  
  for (int i = 0; i < cores; i++){
    threads.push_back(std::thread(say_hello));
    //threads[i] = t1;
  }

  for (int i = 0; i < cores; i++){
    threads[i].join();
  }
  
  //std::thread t1(say_hello);
  //std::thread t2(say_hello);

  //t1.join();
  //t2.join();

  return 0;
}
