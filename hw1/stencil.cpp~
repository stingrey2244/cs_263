#include <iostream>
#include <vector>
#include <random>
#include <thread>

const int ITERATIONS = 100;
const int ROWS = 10; //its a square so rows = cols

void stencil(std::vector<std::vector<float>>& X, std::vector<std::vector<float>>& new_vec,  int thread_num){
  int N = thread_num/ROWS;
  int M = thread_num % ROWS;
  if(N != 0 && M != 0 && N != ROWS - 1 && M != ROWS - 1){
    new_vec[N][M] = (X[N-1][M] + X[N][M-1] + X[N+1][M] + X[N][M+1] + X[N][M])/5.0;
  }
}

std::vector<std::vector<float>> vector_init(int rows){//I'm not counting this towards my time complexity lol :p
  std::vector<std::vector<float>> vec(rows, std::vector<float>(rows, 0.000f));
 
  std::random_device rd;
  std::mt19937 gen(rd());
  std::uniform_real_distribution<float> dis(0.0f, 100.0f);
  
  for(int i = 1; i < rows - 1; i++){
    for(int j = 1; j < rows - 1; j++){
      vec[i][j] = dis(gen);
    }
  }
  return vec;
}


int main(){
  std::vector<std::vector<float>> vec = vector_init(ROWS);
  //using as many threads as there are cells haha
  int NUM_THREADS = ROWS*ROWS;
  std::vector<std::vector<float>> new_vec(ROWS, std::vector<float>(ROWS));

  std::cout << "Initial grid: " << std::endl;
  for (int i = 1; i < ROWS; i++) {
    for (int j = 1; j < ROWS; j++) {
        std::cout << vec[i][j] << ' ';
    }
    std::cout << std::endl;
  }

  for (int iter = 0; iter < ITERATIONS; iter++) {
    std::vector<std::thread> threads;
    
    for (int i = 0; i < NUM_THREADS; i++){
      threads.push_back(std::thread(stencil, std::ref(vec), std::ref(new_vec), i));
    }
    
    for (int i = 0; i < threads.size(); i++){
      threads[i].join();
    }

    vec = new_vec;
  }

  std::cout << "After " << ITERATIONS << " iterations: " << std::endl;
  for (int i = 1; i < ROWS; i++) {
    for (int j = 1; j < ROWS; j++) {
        std::cout << new_vec[i][j] << ' ';
    }
    std::cout << std::endl;
  }
  
}
